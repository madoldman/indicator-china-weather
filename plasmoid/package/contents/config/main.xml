<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="Weather">
    <!-- 已废弃：城市配置迁移到共享 gsettings org.china-weather-data.settings
         的 citylist / autolocate（多城市，与应用侧读写同一份）。
         以下两项仅供 C++ 端一次性迁移旧 kcfg 单城市配置使用（见
         plasmoid/src/weatherclient.cpp 的 migrateLegacyCity）；不要删除条目
         （删除会破坏既有用户小部件配置的结构），也不要再让配置界面读写它们。 -->
    <entry name="cityId" type="String">
      <label>城市 ID（已废弃，仅用于一次性迁移到共享 gsettings）</label>
    </entry>
    <entry name="cityName" type="String">
      <label>城市名称（已废弃，仅用于一次性迁移到共享 gsettings）</label>
    </entry>
  </group>

</kcfg>
